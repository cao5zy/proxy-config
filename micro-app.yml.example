
# micro-app.yml 示例
# 将此文件复制到每个微应用目录下，并根据需要修改

# 访问路径（static/api类型必需）
# 支持多个路径配置
routes: ["/"]

# Docker容器名称（必需，全局唯一）
# 在整个系统中不能重复
container_name: "my-container"

# 容器内部端口（必需）
# 微应用监听的端口
container_port: 80

# HTTP 健康检查路径（可选，默认 "/"）
# 部署时 micro_proxy 会请求 http://127.0.0.1:<container_port><healthcheck_path>
# 后端服务常见示例："/healthz" 或 "/ready"
healthcheck_path: "/"

# 应用类型（必需）
# 可选值: static, api, internal
# - static: 静态网站
# - api: API服务
# - internal: 内部服务（如Redis、MySQL等，不需要nginx反向代理）
app_type: "static"

# 应用包类型（可选，默认 "source"）
# - source: 从本目录 Dockerfile 和源码构建镜像
# - image: 导入已在构建机打好标签的 Docker 镜像归档；此时不需要 Dockerfile 或源码
# - registry: 直接使用镜像仓库中的已有镜像；不需要 Dockerfile、源码或 image.tar
package_type: "source"

# 目标镜像平台（仅 source 包可选）。
# 例如在 Apple Silicon Mac 上构建、部署到 AMD64 Linux 服务器时，取消下一行注释。
# micro_proxy 会使用 `docker buildx build --platform linux/amd64 --load`。
# build_platform: "linux/amd64"

# 镜像归档（仅 package_type: image 时必需；相对路径基于本目录）
# 使用构建机的 `micro_proxy build my_app --export` 生成；文件名固定为 image.tar。
# 部署机运行 `micro_proxy build my_app` 时会执行 docker load，且保留归档内的标签。
# image_archive: "image.tar"

# 仓库镜像引用（仅 package_type: registry 时必需）。build 时本地不存在才会 docker pull。
# 建议使用固定版本或 digest，例如 postgres:15.8-alpine 或 postgres@sha256:...。
# image: "postgres:15-alpine"

# 应用描述（可选）
description: "我的微应用"

# Docker volumes 映射（可选）
# 用于将宿主机目录或文件挂载到容器中
# 格式: "宿主机路径:容器路径" 或 "宿主机路径:容器路径:ro"（只读）
docker_volumes:
  - "./data:/app/data"           # 读写挂载
  - "./config:/app/config:ro"    # 只读挂载

# 额外的 nginx 配置（可选）
# 仅对 static 和 api 类型有效
# 可以添加自定义的 nginx 配置，如 CORS 头、超时设置等
nginx_extra_config: |
  # 添加CORS头
  add_header 'Access-Control-Allow-Origin' '*' always;
  add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, OPTIONS' always;
  add_header 'Access-Control-Allow-Headers' 'Content-Type, Authorization' always;
  
  # 自定义超时设置
  proxy_connect_timeout 60s;
  proxy_send_timeout 60s;
  proxy_read_timeout 60s;
